# Secretos y entorno (cada clon tiene su .env y nunca se sube)
.env*
/keys/
*.p8
*.pem

# Herramientas locales
.idea/

# Airflow
airflow/logs/*
__pycache__/
*.pyc

# dbt (los modelos de staging y raw_vault los genera el DAG desde metadata/: no se versionan)
dbt/models/staging/
dbt/models/raw_vault/
dbt/tests/*_matches_staging.sql
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Datos de entrada: no se versionan (los lotes de CSV de data/ se colocan a mano en cada entorno)
data/

# Documentación: no se versiona en este repositorio
docs/
